[project]
name = "{{ name }}"
version = "0.1.0"
description = "Generated by the codegen pipeline."
requires-python = ">=3.12"
dependencies = [
{% for dep in dependencies %}
    "{{ dep }}",
{% endfor %}
]

[dependency-groups]
dev = [
{% for dep in dev_dependencies %}
    "{{ dep }}",
{% endfor %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["{{ name }}"]
