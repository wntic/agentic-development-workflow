from pydantic_settings import BaseSettings, SettingsConfigDict

__all__ = ["{{ class_name }}"]


class {{ class_name }}(BaseSettings):
    model_config = SettingsConfigDict(
        env_prefix="{{ env_prefix }}",
        env_file=".env",
        extra="ignore",
    )

{% for decl in fields %}
    {{ decl }}
{% endfor %}
